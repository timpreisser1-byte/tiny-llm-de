# Allowlist: only code, documentation and the small question sets are tracked.
# Everything else stays local - training data, checkpoints, Wikipedia indexes,
# Wikidata tables, voice recordings, logs, old experiments (archiv/) -
# including files created in the future.
/*
!/.gitignore
!/requirements.txt
!/*.py
!/*.sh
!/*.md
!/*.html
!/tokenizer/
!/esp32_sd/
!/knowledge/
!/lm/
!/training/
!/evaluation/
!/speech/
!/scripts/
!/docs/

# cloud GPU infrastructure (access, watchdog, fetcher, costs) stays local
/podauf.sh
/wache_vorlage.sh
/holen_vorlage.sh
/weiter_vorlage.sh
/kosten.sh
/stand.sh
/stand_pod.sh
/statusleiste.sh
/kette7.sh
/lauf_lesen.sh
/lauf_lesen_c.sh

# device folder: code only - no indexes (1.2 GB), no personal memory log
/esp32_sd/wiki_sd*/
/esp32_sd/*.jsonl
gedaechtnis*.jsonl

__pycache__/
*.pyc
.DS_Store
*.bak
*.pt
*.bin
*.wav
*.log

# generated model reports contain absolute local paths
/esp32_sd/reports/*.manifest.json
