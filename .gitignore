# Positivliste: nur Code, Dokumentation und kleine Pruefsaetze gehen ins Repo.
# (archiv/ mit alten Versuchen und Laufskripten bleibt ebenfalls lokal.)
# Alles andere bleibt lokal - Trainingsdaten, Modelle, Wikipedia-Indizes,
# Wikidata-Tabellen, Sprachaufnahmen, Protokolle - auch kuenftige Dateien.
/*
!/.gitignore
!/requirements.txt
!/*.py
!/*.sh
!/*.md
!/*.html
!/chat_fragen_*.json
!/tokenizer/
!/esp32_sd/

# Pod-Infrastruktur (Zugang, Waechter, Abholer, Kosten) bleibt draussen
/podauf.sh
/wache_vorlage.sh
/holen_vorlage.sh
/weiter_vorlage.sh
/kosten.sh
/stand.sh
/stand_pod.sh
/statusleiste.sh
/kette7.sh
/lauf_lesen.sh
/lauf_lesen_c.sh

# im Geraete-Ordner nur Code: Indizes (1,2 GB) und das persoenliche Gedaechtnis nicht
/esp32_sd/wiki_sd*/
/esp32_sd/*.jsonl
gedaechtnis*.jsonl

__pycache__/
*.pyc
.DS_Store
*.bak
*.pt
*.bin
*.wav
*.log

# erzeugte Modellberichte enthalten absolute lokale Pfade
/esp32_sd/reports/*.manifest.json
